// firestore.rules
// Arquivo que contém as regras de acesso ao banco de dados do Firebase
// ========================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(userId) {
      return /databases/$(database)/documents/usuarios/$(userId);
    }

    function invitePath(token) {
      return /databases/$(database)/documents/convites/$(token);
    }

    function familyPath(familyId) {
      return /databases/$(database)/documents/familias/$(familyId);
    }

    function accountPath(familyId, accountId) {
      return /databases/$(database)/documents/familias/$(familyId)/contas/$(accountId);
    }

    function transactionPath(familyId, transactionId) {
      return /databases/$(database)/documents/familias/$(familyId)/transacoes/$(transactionId);
    }

    function transferPath(familyId, transferId) {
      return /databases/$(database)/documents/familias/$(familyId)/transferencias/$(transferId);
    }

    function familyResourcePath(familyId, collectionName, resourceId) {
      return /databases/$(database)/documents/familias/$(familyId)/$(collectionName)/$(resourceId);
    }

    function familyMember(familyId) {
      return signedIn()
        && existsAfter(userPath(request.auth.uid))
        && getAfter(userPath(request.auth.uid)).data.familiaId == familyId;
    }

    function familyPrincipal(familyId) {
      return familyMember(familyId)
        && getAfter(userPath(request.auth.uid)).data.papel == 'PRINCIPAL';
    }

    function validAccountBalance(familyId, accountId, transactionId, movement) {
      let path = accountPath(familyId, accountId);
      let movementPath = transactionPath(familyId, transactionId);
      let before = get(path).data.saldoAtual;
      let after = getAfter(path).data;
      return exists(path)
        && movement.contaId == accountId
        && existsAfter(movementPath)
        && (
          !exists(movementPath)
          || (get(movementPath).data.status == 'PENDENTE'
            && getAfter(movementPath).data.status == 'EFETIVADO')
        )
        && getAfter(movementPath).data.status == 'EFETIVADO'
        && after.ultimaMovimentacaoId == transactionId
        && (
          (movement.tipoMovimentacao == 'RECEITA'
            && after.saldoAtual == before + movement.valor)
          || (movement.tipoMovimentacao == 'DESPESA'
            && after.saldoAtual == before - movement.valor)
        );
    }

    function validTransferBalances(familyId, transferId, transfer) {
      let movementPath = transferPath(familyId, transferId);
      let originPath = accountPath(familyId, transfer.contaOrigemId);
      let destinationPath = accountPath(familyId, transfer.contaDestinoId);
      let originBefore = get(originPath).data.saldoAtual;
      let destinationBefore = get(destinationPath).data.saldoAtual;
      let originAfter = getAfter(originPath).data;
      let destinationAfter = getAfter(destinationPath).data;
      return exists(originPath)
        && exists(destinationPath)
        && existsAfter(movementPath)
        && (
          !exists(movementPath)
          || (get(movementPath).data.status == 'PENDENTE'
            && getAfter(movementPath).data.status == 'EFETIVADO')
        )
        && originAfter.ultimaMovimentacaoId == transfer.transacaoOrigemId
        && destinationAfter.ultimaMovimentacaoId == transfer.transacaoDestinoId
        && originAfter.saldoAtual == originBefore - transfer.valor
        && destinationAfter.saldoAtual == destinationBefore + transfer.valor
        && transfer.status == 'EFETIVADO';
    }

    function validTransferLeg(familyId, transactionId, movement) {
      let path = transferPath(familyId, movement.transferenciaId);
      let transfer = getAfter(path).data;
      let isOrigin = transfer.transacaoOrigemId == transactionId
        && transfer.contaOrigemId == movement.contaId
        && movement.direcaoTransferencia == 'SAIDA'
        && transfer.contaDestinoId == movement.contaDestinoId;
      let isDestination = transfer.transacaoDestinoId == transactionId
        && transfer.contaDestinoId == movement.contaId
        && movement.direcaoTransferencia == 'ENTRADA'
        && transfer.contaOrigemId == movement.contaDestinoId;
      return existsAfter(path)
        && transfer.valor == movement.valor
        && transfer.status == movement.status
        && movement.tipoMovimentacao == 'TRANSFERENCIA'
        && movement.categoriaNome == 'Transferência'
        && (isOrigin || isDestination)
        && (movement.status == 'PENDENTE' || validTransferBalances(familyId, movement.transferenciaId, transfer));
    }

    function validMovementShape(movement) {
      return movement.keys().hasAll([
          'descricao', 'valor', 'tipoMovimentacao', 'status', 'dataTransacao',
          'contaId', 'categoriaId', 'categoriaNome', 'criadoPorUsuarioId',
          'criadoPorNome', 'dataCriacao', 'dataAtualizacao', 'estornado'
        ])
        && movement.keys().hasOnly([
          'descricao', 'valor', 'tipoMovimentacao', 'status', 'dataTransacao',
          'contaId', 'contaDestinoId', 'categoriaId', 'categoriaNome',
          'criadoPorUsuarioId', 'criadoPorNome', 'dataCriacao', 'dataAtualizacao',
          'estornado', 'transferenciaId', 'direcaoTransferencia',
          'atualizadoPorUsuarioId', 'formaPagamento', 'parcelas', 'diaVencimento',
          'cartaoPlasticoId', 'parcelamentoId', 'recorrenciaId', 'faturaId',
          'parcelaAtual', 'observacao'
        ])
        && movement.descricao is string
        && movement.descricao.size() > 0
        && movement.valor is number
        && movement.valor > 0
        && movement.status in ['EFETIVADO', 'PENDENTE']
        && movement.tipoMovimentacao in ['RECEITA', 'DESPESA', 'TRANSFERENCIA']
        && movement.dataTransacao is timestamp
        && movement.categoriaId is string
        && movement.criadoPorUsuarioId == request.auth.uid
        && movement.criadoPorNome is string
        && movement.dataCriacao is timestamp
        && movement.dataAtualizacao is timestamp
        && movement.estornado == false
        && (!('cartaoPlasticoId' in movement)
          || exists(familyResourcePath(familyId, 'cartoes_plasticos', movement.cartaoPlasticoId)))
        && (!('parcelamentoId' in movement)
          || exists(familyResourcePath(familyId, 'parcelamentos', movement.parcelamentoId)))
        && (!('recorrenciaId' in movement)
          || exists(familyResourcePath(familyId, 'recorrencias', movement.recorrenciaId)))
        && (!('faturaId' in movement)
          || exists(familyResourcePath(familyId, 'faturas_cartao', movement.faturaId)))
        && (!('parcelaAtual' in movement)
          || (movement.parcelaAtual is int && movement.parcelaAtual > 0))
        && (!('observacao' in movement) || movement.observacao is string)
        && (
          (movement.tipoMovimentacao == 'TRANSFERENCIA'
            && movement.contaDestinoId is string
            && movement.transferenciaId is string
            && movement.direcaoTransferencia in ['SAIDA', 'ENTRADA']
            && movement.categoriaNome == 'Transferência')
          || (
            movement.tipoMovimentacao in ['RECEITA', 'DESPESA']
            && movement.contaId is string
            && movement.categoriaNome is string
            && movement.get('transferenciaId', null) == null
          )
        );
    }

    function validNewTransaction(familyId, transactionId, movement) {
      let path = accountPath(familyId, movement.contaId);
      return validMovementShape(movement)
        && (movement.tipoMovimentacao == 'TRANSFERENCIA'
          ? validTransferLeg(familyId, transactionId, movement)
          : exists(path)
            && (movement.status == 'PENDENTE'
              || validAccountBalance(familyId, movement.contaId, transactionId, movement)));
    }

    function validAccountEffect(familyId, accountId, transactionId) {
      let movementPath = transactionPath(familyId, transactionId);
      let movement = getAfter(movementPath).data;
      return existsAfter(movementPath)
        && (movement.tipoMovimentacao == 'TRANSFERENCIA'
          ? (
            (accountId == getAfter(transferPath(familyId, movement.transferenciaId)).data.contaOrigemId
              || accountId == getAfter(transferPath(familyId, movement.transferenciaId)).data.contaDestinoId)
            && validTransferBalances(
              familyId,
              movement.transferenciaId,
              getAfter(transferPath(familyId, movement.transferenciaId)).data
            )
          )
          : validAccountBalance(familyId, accountId, transactionId, movement));
    }

    function validEffectiveTransactionUpdate(familyId, transactionId) {
      let movement = request.resource.data;
      return resource.data.status == 'PENDENTE'
        && movement.status == 'EFETIVADO'
        && movement.estornado == false
        && movement.criadoPorUsuarioId == resource.data.criadoPorUsuarioId
        && movement.contaId == resource.data.contaId
        && movement.valor == resource.data.valor
        && movement.tipoMovimentacao == resource.data.tipoMovimentacao
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'dataAtualizacao', 'atualizadoPorUsuarioId'])
        && (movement.tipoMovimentacao == 'TRANSFERENCIA'
          ? validTransferLeg(familyId, transactionId, movement)
          : validAccountBalance(familyId, movement.contaId, transactionId, movement));
    }

    function movementEffect(movement) {
      return movement.status == 'EFETIVADO' && movement.estornado == false
        ? (movement.tipoMovimentacao == 'RECEITA' ? movement.valor : -movement.valor)
        : 0;
    }

    function transferEffect(transfer, accountId) {
      return transfer.status == 'EFETIVADO' && transfer.get('estornado', false) == false
        ? (accountId == transfer.contaOrigemId
          ? -transfer.valor
          : (accountId == transfer.contaDestinoId ? transfer.valor : 0))
        : 0;
    }

    function validAccountDelta(familyId, accountId, movementId, delta) {
      let path = accountPath(familyId, accountId);
      let before = get(path).data;
      let after = getAfter(path).data;
      return exists(path)
        && existsAfter(path)
        && after.saldoAtual == before.saldoAtual + delta
        && (delta == 0 || after.ultimaMovimentacaoId == movementId);
    }

    function validTransactionBalanceAdjustment(familyId, transactionId) {
      let movementPath = transactionPath(familyId, transactionId);
      let before = get(movementPath).data;
      let after = getAfter(movementPath).data;
      let oldAccount = before.contaId;
      let newAccount = after.contaId;
      let delta = movementEffect(after) - movementEffect(before);
      return before.tipoMovimentacao in ['RECEITA', 'DESPESA']
        && after.tipoMovimentacao in ['RECEITA', 'DESPESA']
        && exists(accountPath(familyId, oldAccount))
        && exists(accountPath(familyId, newAccount))
        && (oldAccount == newAccount
          ? validAccountDelta(familyId, newAccount, transactionId, delta)
          : validAccountDelta(familyId, oldAccount, transactionId, -movementEffect(before))
            && validAccountDelta(familyId, newAccount, transactionId, movementEffect(after)));
    }

    function validTransferAccountAdjustment(familyId, transferId, accountId) {
      let beforePath = transferPath(familyId, transferId);
      let before = get(beforePath).data;
      let after = getAfter(beforePath).data;
      let delta = transferEffect(after, accountId) - transferEffect(before, accountId);
      let movementId = accountId == after.contaOrigemId
        ? after.transacaoOrigemId
        : (accountId == after.contaDestinoId
          ? after.transacaoDestinoId
          : (accountId == before.contaOrigemId
            ? before.transacaoOrigemId
            : before.transacaoDestinoId));
      return exists(beforePath)
        && existsAfter(beforePath)
        && validAccountDelta(familyId, accountId, movementId, delta);
    }

    function validTransferBalanceAdjustment(familyId, transferId, transfer) {
      let before = get(transferPath(familyId, transferId)).data;
      return validTransferAccountAdjustment(familyId, transferId, before.contaOrigemId)
        && validTransferAccountAdjustment(familyId, transferId, before.contaDestinoId)
        && validTransferAccountAdjustment(familyId, transferId, transfer.contaOrigemId)
        && validTransferAccountAdjustment(familyId, transferId, transfer.contaDestinoId);
    }

    function validTransferAccountAdjustmentFromMovement(familyId, accountId, movementId) {
      let movement = getAfter(transactionPath(familyId, movementId)).data;
      return movement.tipoMovimentacao == 'TRANSFERENCIA'
        && validTransferAccountAdjustment(familyId, movement.transferenciaId, accountId);
    }

    function validEditableTransaction(familyId, transactionId) {
      let movement = request.resource.data;
      return resource.data.tipoMovimentacao in ['RECEITA', 'DESPESA']
        && resource.data.estornado == false
        && movement.keys().hasOnly([
          'descricao', 'valor', 'tipoMovimentacao', 'status', 'dataTransacao',
          'contaId', 'contaDestinoId', 'categoriaId', 'categoriaNome',
          'criadoPorUsuarioId', 'criadoPorNome', 'dataCriacao', 'dataAtualizacao',
          'estornado', 'transferenciaId', 'direcaoTransferencia',
          'atualizadoPorUsuarioId', 'formaPagamento', 'parcelas', 'diaVencimento',
          'cartaoPlasticoId', 'parcelamentoId', 'recorrenciaId', 'faturaId',
          'parcelaAtual', 'observacao'
        ])
        && movement.criadoPorUsuarioId == resource.data.criadoPorUsuarioId
        && movement.criadoPorNome == resource.data.criadoPorNome
        && movement.dataCriacao == resource.data.dataCriacao
        && movement.tipoMovimentacao in ['RECEITA', 'DESPESA']
        && movement.status in ['EFETIVADO', 'PENDENTE']
        && movement.estornado is bool
        && movement.valor is number
        && movement.valor > 0
        && movement.descricao is string
        && movement.descricao.size() > 0
        && movement.dataTransacao is timestamp
        && movement.dataAtualizacao is timestamp
        && movement.atualizadoPorUsuarioId == request.auth.uid
        && movement.contaId is string
        && movement.categoriaId is string
        && movement.categoriaNome is string
        && movement.transferenciaId == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'descricao', 'valor', 'tipoMovimentacao', 'status', 'dataTransacao',
          'contaId', 'categoriaId', 'categoriaNome', 'dataAtualizacao',
          'estornado', 'atualizadoPorUsuarioId'
        ])
        && validTransactionBalanceAdjustment(familyId, transactionId);
    }

    function validUpdatedTransferLeg(familyId, transactionId, movement) {
      return resource.data.tipoMovimentacao == 'TRANSFERENCIA'
        && resource.data.estornado == false
        && movement.tipoMovimentacao == 'TRANSFERENCIA'
        && movement.transferenciaId == resource.data.transferenciaId
        && movement.criadoPorUsuarioId == resource.data.criadoPorUsuarioId
        && movement.dataCriacao == resource.data.dataCriacao
        && movement.keys().hasOnly([
          'descricao', 'valor', 'tipoMovimentacao', 'status', 'dataTransacao',
          'contaId', 'contaDestinoId', 'categoriaId', 'categoriaNome',
          'criadoPorUsuarioId', 'criadoPorNome', 'dataCriacao', 'dataAtualizacao',
          'estornado', 'transferenciaId', 'direcaoTransferencia',
          'atualizadoPorUsuarioId', 'formaPagamento', 'parcelas', 'diaVencimento',
          'cartaoPlasticoId', 'parcelamentoId', 'recorrenciaId', 'faturaId',
          'parcelaAtual', 'observacao'
        ])
        && movement.status in ['EFETIVADO', 'PENDENTE']
        && movement.valor is number
        && movement.valor > 0
        && movement.descricao is string
        && movement.descricao.size() > 0
        && movement.dataTransacao is timestamp
        && movement.dataAtualizacao is timestamp
        && movement.atualizadoPorUsuarioId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'descricao', 'valor', 'status', 'dataTransacao', 'contaId',
          'contaDestinoId', 'dataAtualizacao', 'estornado', 'atualizadoPorUsuarioId'
        ])
        && existsAfter(transferPath(familyId, movement.transferenciaId))
        && movement.estornado
          == getAfter(transferPath(familyId, movement.transferenciaId)).data.get('estornado', false)
        && validTransferDocument(
          familyId,
          movement.transferenciaId,
          getAfter(transferPath(familyId, movement.transferenciaId)).data
        );
    }

    function validTransferDocument(familyId, transferId, transfer) {
      let originTransaction = getAfter(transactionPath(familyId, transfer.transacaoOrigemId)).data;
      let destinationTransaction = getAfter(transactionPath(familyId, transfer.transacaoDestinoId)).data;
      return transfer.keys().hasAll([
          'contaOrigemId', 'contaDestinoId', 'transacaoOrigemId',
          'transacaoDestinoId', 'status', 'valor', 'dataTransacao',
          'criadoPorUsuarioId', 'dataCriacao'
        ])
        && transfer.keys().hasOnly([
          'contaOrigemId', 'contaDestinoId', 'transacaoOrigemId',
          'transacaoDestinoId', 'status', 'valor', 'dataTransacao',
          'criadoPorUsuarioId', 'dataCriacao', 'dataAtualizacao', 'estornado'
        ])
        && transfer.contaOrigemId is string
        && transfer.contaDestinoId is string
        && transfer.contaOrigemId != transfer.contaDestinoId
        && transfer.transacaoOrigemId is string
        && transfer.transacaoDestinoId is string
        && transfer.transacaoOrigemId != transfer.transacaoDestinoId
        && transfer.valor is number
        && transfer.valor > 0
        && transfer.status in ['EFETIVADO', 'PENDENTE']
        && transfer.dataTransacao is timestamp
        && transfer.dataCriacao is timestamp
        && existsAfter(transactionPath(familyId, transfer.transacaoOrigemId))
        && existsAfter(transactionPath(familyId, transfer.transacaoDestinoId))
        && originTransaction.tipoMovimentacao == 'TRANSFERENCIA'
        && destinationTransaction.tipoMovimentacao == 'TRANSFERENCIA'
        && originTransaction.transferenciaId == transferId
        && destinationTransaction.transferenciaId == transferId
        && originTransaction.direcaoTransferencia == 'SAIDA'
        && destinationTransaction.direcaoTransferencia == 'ENTRADA'
        && originTransaction.status == transfer.status
        && destinationTransaction.status == transfer.status
        && originTransaction.valor == transfer.valor
        && destinationTransaction.valor == transfer.valor
        && originTransaction.contaId == transfer.contaOrigemId
        && destinationTransaction.contaId == transfer.contaDestinoId
        && originTransaction.contaDestinoId == transfer.contaDestinoId
        && destinationTransaction.contaDestinoId == transfer.contaOrigemId
        && originTransaction.criadoPorUsuarioId == transfer.criadoPorUsuarioId
        && destinationTransaction.criadoPorUsuarioId == transfer.criadoPorUsuarioId
        && originTransaction.descricao == destinationTransaction.descricao
        && originTransaction.dataTransacao == transfer.dataTransacao
        && destinationTransaction.dataTransacao == transfer.dataTransacao
        && originTransaction.estornado == transfer.get('estornado', false)
        && destinationTransaction.estornado == transfer.get('estornado', false);
    }

    match /usuarios/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'nome', 'email', 'papel', 'usuarioPaiId', 'familiaId', 'dataCriacao', 'conviteToken'
        ])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nome is string
        && request.resource.data.dataCriacao is timestamp
        && (
          (
            request.resource.data.papel == 'PRINCIPAL'
            && request.resource.data.familiaId == userId
            && request.resource.data.usuarioPaiId == null
            && existsAfter(familyPath(userId))
            && getAfter(familyPath(userId)).data.principalUsuarioId == userId
          )
          || (
            request.resource.data.papel == 'SECUNDARIO'
            && request.resource.data.usuarioPaiId is string
            && request.resource.data.familiaId is string
            && request.resource.data.conviteToken is string
            && existsAfter(invitePath(request.resource.data.conviteToken))
            && getAfter(invitePath(request.resource.data.conviteToken)).data.statusConvite == 'ACEITO'
            && getAfter(invitePath(request.resource.data.conviteToken)).data.usuarioAceitoId == userId
            && getAfter(invitePath(request.resource.data.conviteToken)).data.emailConvidado == request.auth.token.email
            && getAfter(invitePath(request.resource.data.conviteToken)).data.familiaId == request.resource.data.familiaId
            && getAfter(invitePath(request.resource.data.conviteToken)).data.usuarioPrincipalId == request.resource.data.usuarioPaiId
          )
        );
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome'])
        && request.resource.data.nome is string;
      allow delete: if false;
    }

    match /instituicoes_bancarias/{institutionId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /familias/{familyId} {
      allow read: if signedIn() && (request.auth.uid == familyId || familyMember(familyId));
      allow create: if signedIn()
        && request.auth.uid == familyId
        && request.resource.data.principalUsuarioId == request.auth.uid;
      allow update, delete: if false;

      match /contas/{accountId} {
        allow read: if familyMember(familyId);
        allow create: if familyMember(familyId)
          && request.resource.data.keys().hasOnly([
            'nome', 'tipoConta', 'saldoAtual', 'limiteTotal', 'diaFechamento',
            'diaVencimento', 'ativo', 'criadaPorUsuarioId', 'dataCriacao',
            'usuarioId', 'instituicaoId'
          ])
          && request.resource.data.nome is string
          && request.resource.data.tipoConta in ['CORRENTE', 'POUPANCA', 'CARTAO_CREDITO', 'CAIXINHA']
          && request.resource.data.saldoAtual is number
          && request.resource.data.ativo == true
          && request.resource.data.criadaPorUsuarioId == request.auth.uid
          && request.resource.data.dataCriacao is timestamp
          && (request.resource.data.get('usuarioId', null) == null
            || get(userPath(request.resource.data.usuarioId)).data.familiaId == familyId)
          && (request.resource.data.get('instituicaoId', null) == null
            || exists(/databases/$(database)/documents/instituicoes_bancarias/$(request.resource.data.instituicaoId)));
        allow update: if familyMember(familyId)
          && (
            (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['nome', 'tipoConta', 'ativo', 'usuarioId', 'instituicaoId'])
              && request.resource.data.nome is string
              && request.resource.data.tipoConta in ['CORRENTE', 'POUPANCA', 'CARTAO_CREDITO', 'CAIXINHA']
              && request.resource.data.ativo is bool
              && (request.resource.data.get('usuarioId', null) == null
                || get(userPath(request.resource.data.usuarioId)).data.familiaId == familyId)
              && (request.resource.data.get('instituicaoId', null) == null
                || exists(/databases/$(database)/documents/instituicoes_bancarias/$(request.resource.data.instituicaoId)))
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['saldoAtual', 'ultimaMovimentacaoId'])
              && 'ultimaMovimentacaoId' in request.resource.data
              && request.resource.data.saldoAtual is number
              && request.resource.data.ultimaMovimentacaoId is string
              && (
                validAccountEffect(familyId, accountId, request.resource.data.ultimaMovimentacaoId)
                || validTransactionBalanceAdjustment(
                  familyId,
                  request.resource.data.ultimaMovimentacaoId
                )
                    || validTransferAccountAdjustmentFromMovement(
                  familyId,
                      accountId,
                      request.resource.data.ultimaMovimentacaoId
                )
              )
            )
          );
        allow delete: if false;
      }

      match /categorias/{categoryId} {
        allow read: if familyMember(familyId);
        allow create: if familyMember(familyId)
          && request.resource.data.keys().hasOnly(['nome', 'icone', 'tipo', 'ativo', 'categoriaPaiId'])
          && request.resource.data.nome is string
          && request.resource.data.icone is string
          && request.resource.data.tipo in ['RECEITA', 'DESPESA', 'TRANSFERENCIA', 'AMBAS']
          && (!('ativo' in request.resource.data) || request.resource.data.ativo == true)
          && (!('categoriaPaiId' in request.resource.data)
            || request.resource.data.categoriaPaiId == null
            || exists(familyResourcePath(familyId, 'categorias', request.resource.data.categoriaPaiId)));
        allow update: if familyMember(familyId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['nome', 'icone', 'tipo', 'ativo', 'categoriaPaiId'])
          && request.resource.data.nome is string
          && request.resource.data.icone is string
          && request.resource.data.tipo in ['RECEITA', 'DESPESA', 'TRANSFERENCIA', 'AMBAS']
          && (!('ativo' in request.resource.data) || request.resource.data.ativo is bool)
          && (!('categoriaPaiId' in request.resource.data)
            || request.resource.data.categoriaPaiId == null
            || exists(familyResourcePath(familyId, 'categorias', request.resource.data.categoriaPaiId)));
        allow delete: if false;
      }

      match /cartoes_plasticos/{cardId} {
        allow read: if familyMember(familyId);
        allow create: if familyMember(familyId)
          && request.resource.data.keys().hasOnly([
            'contaId', 'usuarioPortadorId', 'nomeExibicao', 'bandeira', 'ativo', 'dataCriacao'
          ])
          && request.resource.data.contaId is string
          && exists(accountPath(familyId, request.resource.data.contaId))
          && request.resource.data.nomeExibicao is string
          && request.resource.data.nomeExibicao.size() > 0
          && request.resource.data.bandeira in ['ELO', 'VISA', 'MASTERCARD', 'AMEX', 'HIPERCARD', 'OUTRA']
          && request.resource.data.ativo == true
          && request.resource.data.dataCriacao is timestamp
          && (!('usuarioPortadorId' in request.resource.data)
            || request.resource.data.usuarioPortadorId == null
            || get(userPath(request.resource.data.usuarioPortadorId)).data.familiaId == familyId);
        allow update: if familyMember(familyId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['contaId', 'usuarioPortadorId', 'nomeExibicao', 'bandeira', 'ativo'])
          && request.resource.data.contaId is string
          && exists(accountPath(familyId, request.resource.data.contaId))
          && request.resource.data.nomeExibicao is string
          && request.resource.data.nomeExibicao.size() > 0
          && request.resource.data.bandeira in ['ELO', 'VISA', 'MASTERCARD', 'AMEX', 'HIPERCARD', 'OUTRA']
          && request.resource.data.ativo is bool
          && (!('usuarioPortadorId' in request.resource.data)
            || request.resource.data.usuarioPortadorId == null
            || get(userPath(request.resource.data.usuarioPortadorId)).data.familiaId == familyId);
        allow delete: if false;
      }

      match /orcamentos_metas/{budgetId} {
        allow read: if familyMember(familyId);
        allow create: if familyMember(familyId)
          && request.resource.data.keys().hasOnly([
            'usuarioId', 'categoriaId', 'valorTeto', 'mesAno', 'ativo', 'dataCriacao'
          ])
          && request.resource.data.usuarioId == request.auth.uid
          && exists(familyResourcePath(familyId, 'categorias', request.resource.data.categoriaId))
          && request.resource.data.valorTeto is number
          && request.resource.data.valorTeto > 0
          && request.resource.data.mesAno is string
          && request.resource.data.mesAno.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.resource.data.ativo == true
          && request.resource.data.dataCriacao is timestamp;
        allow update: if familyMember(familyId)
          && resource.data.usuarioId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['categoriaId', 'valorTeto', 'mesAno', 'ativo'])
          && exists(familyResourcePath(familyId, 'categorias', request.resource.data.categoriaId))
          && request.resource.data.valorTeto is number
          && request.resource.data.valorTeto > 0
          && request.resource.data.mesAno.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.resource.data.ativo is bool;
        allow delete: if false;
      }

      match /parcelamentos/{installmentId} {
        allow read: if familyMember(familyId);
        allow create: if familyMember(familyId)
          && request.resource.data.keys().hasOnly([
            'descricao', 'valorTotal', 'totalParcelas', 'dataInicio', 'contaId',
            'categoriaId', 'tipoMovimentacao', 'cartaoPlasticoId', 'ativo',
            'criadoPorUsuarioId', 'dataCriacao'
          ])
          && request.resource.data.descricao is string
          && request.resource.data.descricao.size() > 0
          && request.resource.data.valorTotal is number
          && request.resource.data.valorTotal > 0
          && request.resource.data.totalParcelas is int
          && request.resource.data.totalParcelas > 0
          && request.resource.data.dataInicio is timestamp
          && exists(accountPath(familyId, request.resource.data.contaId))
          && exists(familyResourcePath(familyId, 'categorias', request.resource.data.categoriaId))
          && request.resource.data.tipoMovimentacao in ['RECEITA', 'DESPESA']
          && request.resource.data.ativo == true
          && request.resource.data.criadoPorUsuarioId == request.auth.uid
          && request.resource.data.dataCriacao is timestamp
          && (!('cartaoPlasticoId' in request.resource.data)
            || exists(familyResourcePath(familyId, 'cartoes_plasticos', request.resource.data.cartaoPlasticoId)));
        allow update: if familyMember(familyId)
          && resource.data.criadoPorUsuarioId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'descricao', 'valorTotal', 'totalParcelas', 'dataInicio', 'contaId',
            'categoriaId', 'tipoMovimentacao', 'cartaoPlasticoId', 'ativo'
          ])
          && request.resource.data.descricao is string
          && request.resource.data.descricao.size() > 0
          && request.resource.data.valorTotal is number
          && request.resource.data.valorTotal > 0
          && request.resource.data.totalParcelas is int
          && request.resource.data.totalParcelas > 0
          && request.resource.data.dataInicio is timestamp
          && exists(accountPath(familyId, request.resource.data.contaId))
          && exists(familyResourcePath(familyId, 'categorias', request.resource.data.categoriaId))
          && request.resource.data.tipoMovimentacao in ['RECEITA', 'DESPESA']
          && request.resource.data.ativo is bool
          && (!('cartaoPlasticoId' in request.resource.data)
            || exists(familyResourcePath(familyId, 'cartoes_plasticos', request.resource.data.cartaoPlasticoId)));
        allow delete: if false;
      }

      match /recorrencias/{recurrenceId} {
        allow read: if familyMember(familyId);
        allow create: if familyMember(familyId)
          && request.resource.data.keys().hasOnly([
            'descricao', 'valorEstimado', 'diaVencimento', 'dataProximaExecucao',
            'dataFim', 'contaId', 'categoriaId', 'tipoMovimentacao', 'ativo',
            'criadoPorUsuarioId', 'dataCriacao'
          ])
          && request.resource.data.descricao is string
          && request.resource.data.descricao.size() > 0
          && request.resource.data.valorEstimado is number
          && request.resource.data.valorEstimado > 0
          && request.resource.data.diaVencimento is int
          && request.resource.data.diaVencimento >= 1
          && request.resource.data.diaVencimento <= 31
          && (request.resource.data.dataProximaExecucao == null
            || request.resource.data.dataProximaExecucao is timestamp)
          && (request.resource.data.dataFim == null || request.resource.data.dataFim is timestamp)
          && exists(accountPath(familyId, request.resource.data.contaId))
          && exists(familyResourcePath(familyId, 'categorias', request.resource.data.categoriaId))
          && request.resource.data.tipoMovimentacao in ['RECEITA', 'DESPESA']
          && request.resource.data.ativo == true
          && request.resource.data.criadoPorUsuarioId == request.auth.uid
          && request.resource.data.dataCriacao is timestamp;
        allow update: if familyMember(familyId)
          && resource.data.criadoPorUsuarioId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'descricao', 'valorEstimado', 'diaVencimento', 'dataProximaExecucao',
            'dataFim', 'contaId', 'categoriaId', 'tipoMovimentacao', 'ativo'
          ])
          && request.resource.data.descricao is string
          && request.resource.data.descricao.size() > 0
          && request.resource.data.valorEstimado is number
          && request.resource.data.valorEstimado > 0
          && request.resource.data.diaVencimento is int
          && request.resource.data.diaVencimento >= 1
          && request.resource.data.diaVencimento <= 31
          && (request.resource.data.dataProximaExecucao == null
            || request.resource.data.dataProximaExecucao is timestamp)
          && (request.resource.data.dataFim == null || request.resource.data.dataFim is timestamp)
          && exists(accountPath(familyId, request.resource.data.contaId))
          && exists(familyResourcePath(familyId, 'categorias', request.resource.data.categoriaId))
          && request.resource.data.tipoMovimentacao in ['RECEITA', 'DESPESA']
          && request.resource.data.ativo is bool;
        allow delete: if false;
      }

      match /faturas_cartao/{invoiceId} {
        allow read: if familyMember(familyId);
        allow create: if familyMember(familyId)
          && request.resource.data.keys().hasOnly([
            'contaId', 'mesReferencia', 'valorTotal', 'valorPago', 'status', 'dataCriacao'
          ])
          && exists(accountPath(familyId, request.resource.data.contaId))
          && request.resource.data.mesReferencia.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
          && request.resource.data.valorTotal == 0
          && request.resource.data.valorPago == 0
          && request.resource.data.status == 'ABERTA'
          && request.resource.data.dataCriacao is timestamp;
        allow update: if familyMember(familyId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['valorTotal', 'valorPago', 'status'])
          && request.resource.data.valorTotal is number
          && request.resource.data.valorTotal >= 0
          && request.resource.data.valorPago is number
          && request.resource.data.valorPago >= 0
          && request.resource.data.valorPago <= request.resource.data.valorTotal
          && request.resource.data.status in ['ABERTA', 'FECHADA', 'PAGA'];
        allow delete: if false;
      }

      match /transacoes/{transactionId} {
        allow read: if familyMember(familyId);
        allow create: if familyMember(familyId)
          && validNewTransaction(familyId, transactionId, request.resource.data);
        allow update: if familyMember(familyId)
          && (
            validEffectiveTransactionUpdate(familyId, transactionId)
            || validEditableTransaction(familyId, transactionId)
            || validUpdatedTransferLeg(familyId, transactionId, request.resource.data)
          );
        allow delete: if false;
      }

      match /transferencias/{transferId} {
        allow read: if familyMember(familyId);
        allow create: if familyMember(familyId)
          && request.resource.data.criadoPorUsuarioId == request.auth.uid
          && validTransferDocument(familyId, transferId, request.resource.data)
          && (
            request.resource.data.status == 'PENDENTE'
            || validTransferBalances(familyId, transferId, request.resource.data)
          );
        allow update: if familyMember(familyId)
          && (
            (
              resource.data.status == 'PENDENTE'
              && request.resource.data.status == 'EFETIVADO'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'dataAtualizacao'])
              && request.resource.data.dataAtualizacao is timestamp
              && validTransferDocument(familyId, transferId, request.resource.data)
              && validTransferBalances(familyId, transferId, request.resource.data)
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'contaOrigemId', 'contaDestinoId', 'valor', 'status',
                'dataTransacao', 'dataAtualizacao', 'estornado'
              ])
              && request.resource.data.dataAtualizacao is timestamp
              && (
                request.resource.data.estornado == resource.data.get('estornado', false)
                || request.resource.data.estornado == true
              )
              && validTransferDocument(familyId, transferId, request.resource.data)
              && validTransferBalanceAdjustment(familyId, transferId, request.resource.data)
            )
          );
        allow delete: if false;
      }

      match /logs_atividades/{logId} {
        allow read: if familyMember(familyId);
        allow create: if familyMember(familyId)
          && request.resource.data.keys().hasOnly([
            'transacaoId', 'usuarioId', 'acao', 'dataAcao',
            'descricaoSnapshot', 'valoresAntigos', 'valoresNovos'
          ])
          && request.resource.data.transacaoId is string
          && request.resource.data.usuarioId == request.auth.uid
          && request.resource.data.acao is string
          && request.resource.data.dataAcao is timestamp
          && (!('descricaoSnapshot' in request.resource.data)
            || request.resource.data.descricaoSnapshot is string)
          && (!('valoresAntigos' in request.resource.data)
            || request.resource.data.valoresAntigos is map)
          && (!('valoresNovos' in request.resource.data)
            || request.resource.data.valoresNovos is map);
        allow update, delete: if false;
      }

      match /{collectionName}/{documentId} {
        allow read: if familyMember(familyId);
        allow write: if false;
      }
    }

    match /convites/{token} {
      allow get: if signedIn()
        && (
          request.auth.token.email == resource.data.emailConvidado
          || familyPrincipal(resource.data.familiaId)
        );
      allow list: if signedIn() && familyPrincipal(resource.data.familiaId);
      allow create: if signedIn()
        && familyPrincipal(request.resource.data.familiaId)
        && request.resource.data.keys().hasOnly([
          'token', 'usuarioPrincipalId', 'familiaId', 'emailConvidado',
          'statusConvite', 'dataCriacao', 'dataExpiracao'
        ])
        && request.resource.data.token == token
        && request.resource.data.usuarioPrincipalId == request.auth.uid
        && request.resource.data.statusConvite == 'PENDENTE'
        && request.resource.data.dataExpiracao is timestamp
        && request.resource.data.dataExpiracao > request.time;
      allow update: if signedIn()
        && resource.data.statusConvite == 'PENDENTE'
        && resource.data.emailConvidado == request.auth.token.email
        && resource.data.dataExpiracao > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['statusConvite', 'dataAceite', 'usuarioAceitoId'])
        && request.resource.data.statusConvite == 'ACEITO'
        && request.resource.data.dataAceite is timestamp
        && request.resource.data.dataAceite <= request.time
        && request.resource.data.usuarioAceitoId == request.auth.uid;
      allow delete: if false;
    }
  }
}
