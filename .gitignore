# .gitignore
# Arquivo de ignoração para o Git
#==================================

# ===================================
# Ignorar arquivos iniciados por bkp_
# ===================================
bkp_*
bkp-*
bkp*.*

# ============================
# Node.js
# ============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================
# Firebase
# ============================
firebase-debug.log
dataconnect-debug.log
pglite-debug.log
*.log
firebase.json.local

# ============================
# Firebase Data Connect
# ============================
**/dataconnect-generated/
.dataconnect/
**/pgliteData/

# ============================
# Ambiente
# ============================
.env
.env.local
.env.*.local
.env.development
.env.production

# ============================
# IDEs / Editores
# ============================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ============================
# Build / Distribuição
# ============================
dist/
build/
web-build/
*.local

# ============================
# Expo / React Native
# ============================
.expo/
.expo-shared/
mobileapp/.expo/
mobileapp/web-build/
mobileapp/dist/

# ============================
# Web
# ============================
webapp/dist/
webapp/.env
webapp/.env.local
