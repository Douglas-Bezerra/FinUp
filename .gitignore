# .gitignore
# Arquivo de ignoração para o Git
#==================================

# ============================
# Node.js
# ============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================
# Firebase
# ============================
firebase-debug.log
dataconnect-debug.log
pglite-debug.log
*.log
firebase.json.local

# ============================
# Firebase Data Connect - SDK gerado
# ============================
**/dataconnect-generated/

# ============================
# Ambiente
# ============================
.env
.env.local
.env.*.local
.env.development
.env.production

# ============================
# IDEs / Editores
# ============================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ============================
# Build / Distribuição
# ============================
dist/
build/
web-build/
*.local

# ============================
# Expo / React Native
# ============================
.expo/
.expo-shared/
mobile-app/.expo/
mobile-app/web-build/
mobile-app/dist/

# ============================
# Web
# ============================
web-app/dist/
web-app/.env
web-app/.env.local
